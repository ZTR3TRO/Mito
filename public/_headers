# Cabeceras de Netlify (este archivo se copia tal cual a dist/).
# index.html y sw.js sin caché: el navegador siempre comprueba si hay versión nueva.
# /assets/ lleva hash en el nombre: su contenido nunca cambia, así que caché larga e inmutable.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable
